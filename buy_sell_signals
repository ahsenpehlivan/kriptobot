//@version=6
indicator(title = "buy_sell_signals", overlay = false, timeframe = "", timeframe_gaps = true)



//wavetrend_with_cross

n1 = input(10, "Channel Length")
n2 = input(21, "Average Length")
obLevel1 = input(60, "Over Bought Level 1")
obLevel2 = input(53, "Over Bought Level 2")
osLevel1 = input(-60, "Over Sold Level 1")
osLevel2 = input(-53, "Over Sold Level 2")
 
ap = hlc3 
esa = ta.ema(ap, n1)
d = ta.ema(math.abs(ap - esa), n1)
ci = (ap - esa) / (0.015 * d)
tci = ta.ema(ci, n2)
 
wt1 = tci
wt2 = ta.sma(wt1,4)



//squeeze_momentum_indicator

length = input(20, title="BB Length")
mult = input(2.0,title="BB MultFactor")
lengthKC=input(20, title="KC Length")
multKC = input(1.5, title="KC MultFactor")

useTrueRange = bool(input(true, title="Use TrueRange (KC)"))

// Calculate BB
source = close
basis = ta.sma(source, length)
dev = multKC * ta.stdev(source, length)
upperBB = basis + dev
lowerBB = basis - dev

// Calculate KC
ma = ta.sma(source, lengthKC)
rangeas = useTrueRange ? ta.tr : (high - low)
rangema = ta.sma(rangeas, lengthKC)
upperKC = ma + rangema * multKC
lowerKC = ma - rangema * multKC

sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)
noSqz  = (sqzOn == false) and (sqzOff == false)

val = ta.linreg(source  -  math.avg(math.avg(ta.highest(high, lengthKC), ta.lowest(low, lengthKC)), ta.sma(close,lengthKC)), lengthKC,0)



//supertrend

atrPeriod = input.int(10,    "ATR Length", minval = 1)
factor =    input.float(3.0, "Factor",     minval = 0.01, step = 0.01)

[supertrend, direction] = ta.supertrend(factor, atrPeriod)

supertrend := barstate.isfirst ? na : supertrend
upTrend =    plot(direction < 0 ? supertrend : na, "Up Trend",   color = color.green, style = plot.style_linebr)
downTrend =  plot(direction < 0 ? na : supertrend, "Down Trend", color = color.red,   style = plot.style_linebr)
bodyMiddle = plot(barstate.isfirst ? na : (open + close) / 2, "Body Middle",display = display.none)



//wavetrend_with_cross Conditions
// WT1 Overbought/Oversold Conditions
isOverbought = wt1 > 40 //sell
isOversold = wt1 < -40 //buy

// Cross Conditions
bullishCross = ta.cross(wt1, wt2) and wt1 > wt2 //buy
bearishCross = ta.cross(wt1, wt2) and wt1 < wt2 //sell

wtBuySignal = isOversold and bullishCross
wtSellSignal = isOverbought and bearishCross

//squeeze_momentum_indicator Conditions
var bool squeeze = false 
squeeze := nz(val, 0) > 0

//supertrend Conditions
isUptrendNow = direction > 0 
isDowntrendNow = direction < 0 

var bool buySignal = false
var bool sellSignal = false
buySignal := wtBuySignal and isUptrendNow and squeeze
sellSignal := wtSellSignal and isDowntrendNow and not squeeze

//ALERT
alertcondition(buySignal, "BUY SIGNAL", "wtcross, squeeze_momentum_indicator and supertrend says buy now")
alertcondition(sellSignal, "SELL SIGNAL", "wtcross, squeeze_momentum_indicator and supertrend says sell now")
